{
  "name": "explainshell.com homepage",
  "type": "api",
  "subtype": "http",
  "config": {
    "request": {
      "method": "GET",
      "url": "https://explainshell.com/?_uptime=1",
      "headers": {
        "X-First-Party": "8c3f2e5a4b1d9f6e0a7c"
      },
      "timeout": 30
    },
    "assertions": [
      {
        "operator": "is",
        "type": "statusCode",
        "target": 200
      }
    ]
  },
  "locations": [
    "aws:ap-northeast-1",
    "aws:ap-southeast-2",
    "aws:eu-central-1",
    "aws:us-east-2"
  ],
  "options": {
    "tick_every": 300,
    "min_failure_duration": 0,
    "min_location_failed": 1,
    "follow_redirects": true,
    "retry": {
      "count": 1,
      "interval": 1000
    },
    "monitor_name": "explainshell.com homepage is down"
  },
  "message": "explainshell.com homepage check failed. @idan+alerts@explainshell.com",
  "tags": [
    "service:explainshell",
    "managed_by:claude-code"
  ]
}
