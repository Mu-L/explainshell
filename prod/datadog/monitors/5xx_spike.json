{
  "name": "explainshell 5xx spike",
  "type": "log alert",
  "query": "logs(\"source:explainshell @http.status_code:>=500\").index(\"*\").rollup(\"count\").last(\"5m\") > 20",
  "message": "explainshell.com is returning 5xx errors (more than 20 in 5 minutes). @idan+alerts@explainshell.com",
  "tags": [
    "service:explainshell",
    "managed_by:claude-code"
  ],
  "options": {
    "thresholds": {
      "critical": 20.0
    },
    "notify_no_data": false,
    "renotify_interval": 0,
    "notify_audit": false,
    "new_host_delay": 300,
    "include_tags": true,
    "groupby_simple_monitor": false,
    "silenced": {}
  }
}
